{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/RedFrameworks/schemas/resources.schema.json",
  "title": "RedFrameworks resources",
  "type": "object",
  "required": [
    "updated",
    "schema_version",
    "books",
    "certifications"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "schema_version": {
      "type": "string"
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "authors",
          "publisher",
          "year",
          "level",
          "domains",
          "status",
          "url",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publisher": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "level": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "level",
          "domains",
          "status",
          "url",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
