{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/RedFrameworks/schemas/scenario.schema.json",
  "title": "RedFrameworks defensive validation scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "name",
    "authorization",
    "business_context",
    "threat_basis",
    "mappings",
    "telemetry",
    "detections",
    "response",
    "evidence"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "authorization": {
      "type": "string",
      "minLength": 3
    },
    "business_context": {
      "type": "string",
      "minLength": 3
    },
    "threat_basis": {
      "type": "string",
      "minLength": 3
    },
    "mappings": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          }
        },
        "atlas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "d3fend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "objective"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": true
      }
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "expectation"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "expectation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "expected": {
            "type": "boolean"
          },
          "format": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "response": {
      "type": "object",
      "required": [
        "expected"
      ],
      "properties": {
        "expected": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "target_level"
      ],
      "properties": {
        "target_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
