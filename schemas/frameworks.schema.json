{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/RedFrameworks/schemas/frameworks.schema.json",
  "title": "RedFrameworks framework catalog",
  "type": "object",
  "required": [
    "updated",
    "repository",
    "schema_version",
    "frameworks"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "repository": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "domain",
          "status",
          "url",
          "best_for"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "minLength": 2
          },
          "domain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "verified",
              "community",
              "commercial",
              "legacy",
              "watchlist"
            ]
          },
          "model": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "best_for": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_tier": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "last_reviewed": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
