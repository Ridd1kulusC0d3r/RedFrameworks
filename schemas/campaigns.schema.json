{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/RedFrameworks/schemas/campaigns.schema.json",
  "title": "RedFrameworks campaign intelligence",
  "type": "object",
  "required": [
    "updated",
    "schema_version",
    "source_model",
    "policy",
    "campaigns"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "schema_version": {
      "type": "string"
    },
    "source_model": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "attack_id",
          "actor_ids",
          "first_seen",
          "last_seen",
          "regions",
          "sectors",
          "themes",
          "defensive_focus",
          "source",
          "source_tier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "attack_id": {
            "type": "string",
            "pattern": "^C[0-9]{4}$"
          },
          "actor_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defensive_focus": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "source_tier": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
