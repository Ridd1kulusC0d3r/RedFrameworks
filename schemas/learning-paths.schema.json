{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/RedFrameworks/schemas/learning-paths.schema.json",
  "title": "RedFrameworks learning paths",
  "type": "object",
  "required": [
    "updated",
    "schema_version",
    "paths"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "schema_version": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "audience",
          "domains",
          "frameworks",
          "tools",
          "books",
          "certifications"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "books": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
